  "stations": {
    "osaki": {
      "sources": [
        {
          "title": "大崎駅",
          "url": "https://ja.wikipedia.org/wiki/大崎駅",
          "revision": 110872926
        },
        {
          "title": "大崎 (品川区)",
          "url": "https://ja.wikipedia.org/wiki/大崎_(品川区)",
          "revision": 109393946
        }
      ],
      "traits": [
        {
          "text": "1980年代までは工場が並ぶ地区でした。再開発で、大企業の本社が集まるオフィス街に変わりました。",
          "from": "大崎 (品川区)"
        },
        {
          "text": "隣の五反田が昔から繁華街だったのに対し、大崎はもともと人が訪れることの少ない地区でした。",
          "from": "大崎 (品川区)"
        },
        {
          "text": "大崎ニューシティやゲートシティ大崎など6つのビルが、歩行者デッキで駅と直接つながっています。",
          "from": "大崎駅"
        },
        {
          "text": "2002年に埼京線・りんかい線・湘南新宿ラインが通るようになり、品川と並ぶ山手線南側の乗り換え駅になりました。",
          "from": "大崎 (品川区)"
        },
        {
          "text": "再開発の歴史が浅いため、品川や新宿と比べると高層ビルの数はまだ少ないです。",
          "from": "大崎 (品川区)"
        }
      ]
    },
    "nakameguro": {
      "sources": [
        {
          "title": "中目黒駅",
          "url": "https://ja.wikipedia.org/wiki/中目黒駅",
          "revision": 110796252
        },
        {
          "title": "中目黒",
          "url": "https://ja.wikipedia.org/wiki/中目黒",
          "revision": 109339213
        }
      ],
      "traits": [
        {
          "text": "「ナカメ」の略称で呼ばれる、目黒区の中心の繁華街です。",
          "from": "中目黒駅"
        },
        {
          "text": "駅から線路沿いに目黒銀座商店街が延び、飲食店やセレクトショップが並んでいます。",
          "from": "中目黒駅"
        },
        {
          "text": "目黒川沿いには小さな個性的な飲食店が増えています。川沿いの桜並木には、花見の時期に多くの人が訪れます。",
          "from": "中目黒駅"
        },
        {
          "text": "2003年に目黒区役所が駅の近くへ移り、区の行政の中心にもなっています。",
          "from": "中目黒駅"
        },
        {
          "text": "高架下の商業施設「中目黒高架下」が2016年に開業し、2017年度のグッドデザイン賞を受けました。",
          "from": "中目黒駅"
        }
      ]
    },
    "koenji": {
      "sources": [
        {
          "title": "高円寺駅",
          "url": "https://ja.wikipedia.org/wiki/高円寺駅",
          "revision": 110875626
        },
        {
          "title": "高円寺",
          "url": "https://ja.wikipedia.org/wiki/高円寺",
          "revision": 110613719
        }
      ],
      "traits": [
        {
          "text": "北口と南口の両方に大きな商店街があり、高円寺地区には名前の付いた商店街が14あります。",
          "from": "高円寺"
        },
        {
          "text": "古着屋、古書店、小さなライブハウス、安く食べられる飲食店が多く、休日は若い人が多く訪れます。",
          "from": "高円寺"
        },
        {
          "text": "杉並区の中でも、20代と30代の住民の割合が特に高い地区です。",
          "from": "高円寺"
        },
        {
          "text": "単身者向けのアパートやワンルームマンションが多く、一人暮らしの若い人に人気があります。",
          "from": "高円寺"
        },
        {
          "text": "店の入れ替わりは激しい一方で、戦前からの老舗や昔からの名店も残っています。",
          "from": "高円寺"
        }
      ]
    },
    "kiyosumi-shirakawa": {
      "sources": [
        {
          "title": "清澄白河駅",
          "url": "https://ja.wikipedia.org/wiki/清澄白河駅",
          "revision": 110661422
        },
        {
          "title": "清澄 (江東区)",
          "url": "https://ja.wikipedia.org/wiki/清澄_(江東区)",
          "revision": 104244959
        }
      ],
      "traits": [
        {
          "text": "ブルーボトルコーヒーの日本1号店ができてから「コーヒーの聖地」と呼ばれ、週末は若い観光客が増えました。",
          "from": "清澄 (江東区)"
        },
        {
          "text": "清澄庭園（東京都指定名勝）、東京都現代美術館、木場公園が駅の周りにあります。",
          "from": "清澄白河駅"
        },
        {
          "text": "深川地域の一部で、深川江戸資料館や霊巌寺など、江戸時代につながる名所が残っています。",
          "from": "清澄白河駅"
        },
        {
          "text": "2000年の大江戸線と2003年の半蔵門線の開通で交通の便が良くなり、高層マンションの建設が続いています。",
          "from": "清澄 (江東区)"
        },
        {
          "text": "漫画『のらくろ』にちなんだ商店街「のらくろード」があります。",
          "from": "清澄白河駅"
        }
      ]
    },
    "monzen-nakacho": {
      "sources": [
        {
          "title": "門前仲町駅",
          "url": "https://ja.wikipedia.org/wiki/門前仲町駅",
          "revision": 110661468
        },
        {
          "title": "門前仲町",
          "url": "https://ja.wikipedia.org/wiki/門前仲町",
          "revision": 111097771
        }
      ],
      "traits": [
        {
          "text": "富岡八幡宮と深川不動堂の門前町として、江戸時代から栄えてきた街です。",
          "from": "門前仲町"
        },
        {
          "text": "「門仲（もんなか）」の愛称で呼ばれ、商店街の活動が活発です。",
          "from": "門前仲町"
        },
        {
          "text": "地下鉄2路線と都営バスの発着所があり、深川地域を代表する交通の要所の一つです。",
          "from": "門前仲町"
        },
        {
          "text": "江戸時代には、伊能忠敬をはじめ多くの著名人が住んでいました。",
          "from": "門前仲町"
        }
      ]
    },
    "musashi-koyama": {
      "sources": [
        {
          "title": "武蔵小山駅",
          "url": "https://ja.wikipedia.org/wiki/武蔵小山駅",
          "revision": 110385949
        },
        {
          "title": "小山 (品川区)",
          "url": "https://ja.wikipedia.org/wiki/小山_(品川区)",
          "revision": 107373369
        }
      ],
      "traits": [
        {
          "text": "駅の東側に、アーケード商店街「パルム」があります。",
          "from": "武蔵小山駅"
        },
        {
          "text": "2006年に駅が地下に移り、駅前広場とバス・タクシー乗り場が整備されました。",
          "from": "武蔵小山駅"
        },
        {
          "text": "駅の周りでは、再開発の計画が進んでいます。",
          "from": "武蔵小山駅"
        },
        {
          "text": "町全体が台地の上にあります。",
          "from": "小山 (品川区)"
        }
      ]
    },
    "kita-senju": {
      "sources": [
        {
          "title": "北千住駅",
          "url": "https://ja.wikipedia.org/wiki/北千住駅",
          "revision": 111186393
        },
        {
          "title": "千住",
          "url": "https://ja.wikipedia.org/wiki/千住",
          "revision": 111236115
        }
      ],
      "traits": [
        {
          "text": "江戸時代は日光街道・奥州街道の最初の宿場町で、江戸四宿の一つでした。",
          "from": "千住"
        },
        {
          "text": "足立区で有数の繁華街で、丸井やルミネなどの大型商業施設と、下町の雰囲気が残る商店街が10あまりあります。",
          "from": "北千住駅"
        },
        {
          "text": "東京電機大学など4つの大学が歩いて行ける範囲にあり、学生の多い街でもあります。",
          "from": "北千住駅"
        },
        {
          "text": "銭湯が多いことで知られています。",
          "from": "千住"
        },
        {
          "text": "駅の東側には、海抜ゼロメートル以下の地域があります。",
          "from": "千住"
        }
      ]
    },
    "sangen-jaya": {
      "sources": [
        {
          "title": "三軒茶屋駅",
          "url": "https://ja.wikipedia.org/wiki/三軒茶屋駅",
          "revision": 111209921
        },
        {
          "title": "三軒茶屋",
          "url": "https://ja.wikipedia.org/wiki/三軒茶屋",
          "revision": 109285791
        }
      ],
      "traits": [
        {
          "text": "「三茶」の略称で呼ばれ、「住みたい町」のランキングで上位に入る人気の住宅地です。",
          "from": "三軒茶屋"
        },
        {
          "text": "渋谷に近く、「おしゃれな街」として語られることが多い街です。",
          "from": "三軒茶屋"
        },
        {
          "text": "駅と直結する複合ビル「キャロットタワー」が、街の目印になっています。",
          "from": "三軒茶屋駅"
        },
        {
          "text": "田園都市線のほかに世田谷線が出ています。2つの線は、いったん改札を出て乗り換えます。",
          "from": "三軒茶屋駅"
        },
        {
          "text": "「芸能人が多く住んでいる街」と言われることがあります。",
          "from": "三軒茶屋"
        }
      ]
    },
    "akabane": {
      "sources": [
        {
          "title": "赤羽駅",
          "url": "https://ja.wikipedia.org/wiki/赤羽駅",
          "revision": 110968877
        }
      ],
      "traits": [
        {
          "text": "北区の商業の中心です。",
          "from": "赤羽駅"
        },
        {
          "text": "駅の高架化で線路の東西に分かれていた街がつながり、高架下にも多くの店が入っています。",
          "from": "赤羽駅"
        },
        {
          "text": "駅の北側は、かつて宿場町だった岩淵宿にあたります。",
          "from": "赤羽駅"
        }
      ]
    },
    "kagurazaka": {
      "sources": [
        {
          "title": "神楽坂駅",
          "url": "https://ja.wikipedia.org/wiki/神楽坂駅",
          "revision": 111232443
        },
        {
          "title": "神楽坂",
          "url": "https://ja.wikipedia.org/wiki/神楽坂",
          "revision": 110339273
        }
      ],
      "traits": [
        {
          "text": "大正時代に栄えた花街で、飯田橋駅側の坂の脇には花街特有の路地が残っています。",
          "from": "神楽坂"
        },
        {
          "text": "表通りから一歩入ると静かな路地があり、住宅街の中にレストランや料亭が多くあります。",
          "from": "神楽坂"
        },
        {
          "text": "東京日仏学院などフランス関係の機関が多く、フランスから来た人も見かけます。",
          "from": "神楽坂"
        },
        {
          "text": "休日は坂が歩行者天国になり、毎年夏の神楽坂まつりでは阿波踊り大会が開かれます。",
          "from": "神楽坂"
        },
        {
          "text": "駅の前は閑静な住宅街で、チェーン店やマンションが増えるにつれて、昔ながらの老舗は減っています。",
          "from": "神楽坂駅"
        }
      ]
    },
    "roppongi": {
      "sources": [
        {
          "title": "六本木駅",
          "url": "https://ja.wikipedia.org/wiki/%E5%85%AD%E6%9C%AC%E6%9C%A8%E9%A7%85",
          "revision": 110661715
        },
        {
          "title": "六本木",
          "url": "https://ja.wikipedia.org/wiki/%E5%85%AD%E6%9C%AC%E6%9C%A8",
          "revision": 111160164
        }
      ],
      "traits": [
        {
          "text": "2000年代の再開発で、六本木ヒルズや東京ミッドタウンなど、オフィスと店が入る大規模な複合ビルが開業しました。",
          "from": "六本木"
        },
        {
          "text": "国立新美術館、森美術館、サントリー美術館が、駅から歩いて行ける範囲にあります。",
          "from": "六本木駅"
        },
        {
          "text": "大使館などの外国公館が多く、街を歩く外国人も多い地区です。",
          "from": "六本木"
        },
        {
          "text": "平日はオフィス街として会社員が多く、金曜と土曜の夜はバーやクラブの客が多い繁華街になります。東京都は六本木三丁目から七丁目を、客引きを禁じる区域に指定しています。",
          "from": "六本木"
        },
        {
          "text": "大江戸線の六本木駅のホームは地下約42メートルにあり、日本の地下鉄で最も深いです。",
          "from": "六本木駅"
        }
      ]
    },
    "nogizaka": {
      "sources": [
        {
          "title": "乃木坂駅",
          "url": "https://ja.wikipedia.org/wiki/%E4%B9%83%E6%9C%A8%E5%9D%82%E9%A7%85",
          "revision": 110819727
        }
      ],
      "traits": [
        {
          "text": "国立新美術館が駅のすぐそばにあります。",
          "from": "乃木坂駅"
        },
        {
          "text": "乃木神社と乃木公園が駅のそばにあります。",
          "from": "乃木坂駅"
        },
        {
          "text": "青山霊園と都立青山公園が、駅から歩いて行ける範囲にあります。",
          "from": "乃木坂駅"
        },
        {
          "text": "東京ミッドタウンにも六本木ヒルズにも、歩いて行けます。ただし六本木駅とは、乗り換え駅として扱われていません。",
          "from": "乃木坂駅"
        }
      ]
    },
    "shimbashi": {
      "sources": [
        {
          "title": "新橋駅",
          "url": "https://ja.wikipedia.org/wiki/%E6%96%B0%E6%A9%8B%E9%A7%85",
          "revision": 110943604
        }
      ],
      "traits": [
        {
          "text": "1872年に日本で最初の鉄道が新橋と横浜のあいだで開業し、「鉄道発祥の地」として知られています。",
          "from": "新橋駅"
        },
        {
          "text": "駅前のSL広場は「サラリーマンの街」の象徴として、テレビの街頭インタビューによく使われます。",
          "from": "新橋駅"
        },
        {
          "text": "烏森口側には古くからの商店街と雑居ビルが並び、会社員向けの居酒屋が多くあります。",
          "from": "新橋駅"
        },
        {
          "text": "東側の汐留エリアは、貨物駅の跡地を2000年代に再開発したオフィス街です。日本テレビや電通などの本社が入る超高層ビルが並びます。",
          "from": "新橋駅"
        },
        {
          "text": "銀座口から、銀座6〜8丁目へ歩いて行けます。",
          "from": "新橋駅"
        }
      ]
    },
    "onarimon": {
      "sources": [
        {
          "title": "御成門駅",
          "url": "https://ja.wikipedia.org/wiki/%E5%BE%A1%E6%88%90%E9%96%80%E9%A7%85",
          "revision": 110533446
        }
      ],
      "traits": [
        {
          "text": "東京タワー、芝公園、増上寺が駅の近くにあります。古い駅名標には「東京タワー前」と書かれています。",
          "from": "御成門駅"
        },
        {
          "text": "東京慈恵会医科大学附属病院が駅のそばにあります。",
          "from": "御成門駅"
        },
        {
          "text": "港区役所が近くにあります。",
          "from": "御成門駅"
        },
        {
          "text": "愛宕山の愛宕神社とNHK放送博物館にも、歩いて行けます。",
          "from": "御成門駅"
        }
      ]
    },
    "toranomon": {
      "sources": [
        {
          "title": "虎ノ門駅",
          "url": "https://ja.wikipedia.org/wiki/%E8%99%8E%E3%83%8E%E9%96%80%E9%A7%85",
          "revision": 110817009
        },
        {
          "title": "虎ノ門",
          "url": "https://ja.wikipedia.org/wiki/%E8%99%8E%E3%83%8E%E9%96%80",
          "revision": 110754731
        }
      ],
      "traits": [
        {
          "text": "霞が関・赤坂・六本木とともに、日本最大級のオフィス街と超高層ビル群をつくっています。",
          "from": "虎ノ門"
        },
        {
          "text": "虎ノ門ヒルズの森タワーやステーションタワーなど、超高層ビルが集まっています。2020年には日比谷線の虎ノ門ヒルズ駅が開業しました。",
          "from": "虎ノ門"
        },
        {
          "text": "経済産業省や財務省など、中央省庁が駅のすぐそばにあります。",
          "from": "虎ノ門駅"
        },
        {
          "text": "アメリカ大使館やThe Okura Tokyo（旧ホテルオークラ東京）も、駅の近くにあります。",
          "from": "虎ノ門駅"
        },
        {
          "text": "地名は、江戸城の外堀にあった城門「虎ノ門」に由来します。",
          "from": "虎ノ門"
        }
      ]
    },
    "itabashi": {
      "sources": [
        {
          "title": "板橋駅",
          "url": "https://ja.wikipedia.org/wiki/%E6%9D%BF%E6%A9%8B%E9%A7%85",
          "revision": 109947709
        },
        {
          "title": "板橋 (板橋区)",
          "url": "https://ja.wikipedia.org/wiki/%E6%9D%BF%E6%A9%8B_(%E6%9D%BF%E6%A9%8B%E5%8C%BA)",
          "revision": 109749888
        }
      ],
      "traits": [
        {
          "text": "江戸時代は中山道の最初の宿場「板橋宿」の一部で、川越街道が分かれる「平尾の追分」がありました。",
          "from": "板橋 (板橋区)"
        },
        {
          "text": "駅は北区・板橋区・豊島区の境にあり、東口は北区、西口は板橋区に面しています。",
          "from": "板橋駅"
        },
        {
          "text": "駅の西口では、2019年に東京都が認可した再開発が進んでいます。",
          "from": "板橋駅"
        },
        {
          "text": "地名は、石神井川にかかる橋「板橋」に由来します。",
          "from": "板橋 (板橋区)"
        }
      ]
    },
    "iwamotocho": {
      "sources": [
        {
          "title": "岩本町駅",
          "url": "https://ja.wikipedia.org/wiki/%E5%B2%A9%E6%9C%AC%E7%94%BA%E9%A7%85",
          "revision": 110353748
        },
        {
          "title": "岩本町",
          "url": "https://ja.wikipedia.org/wiki/%E5%B2%A9%E6%9C%AC%E7%94%BA",
          "revision": 106268349
        }
      ],
      "traits": [
        {
          "text": "秋葉原駅のすぐ南にあり、駅名に「秋葉原」の副名称が付いています。秋葉原駅とは乗り換えができます。",
          "from": "岩本町駅"
        },
        {
          "text": "かつて大きな古着市場があった地区で、今も繊維関係の会社や店が残っています。",
          "from": "岩本町"
        },
        {
          "text": "オフィスビルと商店が中心の商業地で、山崎製パンや貝印の本社があります。",
          "from": "岩本町"
        },
        {
          "text": "昭和通りと靖国通りが交わる場所にあり、首都高速1号上野線も通っています。",
          "from": "岩本町駅"
        }
      ]
    },
    "ningyocho": {
      "sources": [
        {
          "title": "人形町駅",
          "url": "https://ja.wikipedia.org/wiki/%E4%BA%BA%E5%BD%A2%E7%94%BA%E9%A7%85",
          "revision": 110706160
        },
        {
          "title": "日本橋人形町",
          "url": "https://ja.wikipedia.org/wiki/%E6%97%A5%E6%9C%AC%E6%A9%8B%E4%BA%BA%E5%BD%A2%E7%94%BA",
          "revision": 110295011
        }
      ],
      "traits": [
        {
          "text": "人形町通りと甘酒横丁を中心に、飲食店や商店が並ぶ商業地です。",
          "from": "日本橋人形町"
        },
        {
          "text": "人形町今半本店や玄冶店 濱田家本店など、老舗の料理店があります。",
          "from": "日本橋人形町"
        },
        {
          "text": "毎年8月に、人形町通りで「せともの市」が開かれます。",
          "from": "日本橋人形町"
        },
        {
          "text": "江戸時代の初めには吉原遊廓があり、その後は芝居小屋が集まる町でした。大門通りの名はその名残です。",
          "from": "日本橋人形町"
        },
        {
          "text": "住宅の都心回帰で住居が増え、人口も増えています。",
          "from": "日本橋人形町"
        }
      ]
    },
    "awajicho": {
      "sources": [
        {
          "title": "淡路町駅",
          "url": "https://ja.wikipedia.org/wiki/%E6%B7%A1%E8%B7%AF%E7%94%BA%E9%A7%85",
          "revision": 110817057
        },
        {
          "title": "神田淡路町",
          "url": "https://ja.wikipedia.org/wiki/%E7%A5%9E%E7%94%B0%E6%B7%A1%E8%B7%AF%E7%94%BA",
          "revision": 110870163
        }
      ],
      "traits": [
        {
          "text": "主に商業地として使われている町で、北側は神田川に面しています。",
          "from": "神田淡路町"
        },
        {
          "text": "再開発でできた複合施設「ワテラス」があります。",
          "from": "神田淡路町"
        },
        {
          "text": "神田駅、秋葉原駅、御茶ノ水駅へ歩いて行ける位置にあり、秋葉原の電気街にも歩いて行けます。",
          "from": "淡路町駅"
        },
        {
          "text": "地名は、神田川沿いの坂「淡路坂」に由来します。",
          "from": "神田淡路町"
        }
      ]
    }
  }
}
